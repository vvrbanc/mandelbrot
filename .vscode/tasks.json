{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Build debug",
			"command": "cmake --preset debug && cmake --build --preset debug",
			"options": { "cwd": "${workspaceFolder}" },
			"group": { "kind": "build", "isDefault": true },
			"detail": "build/ : -ggdb3 -O0 -Wpedantic -Wextra"
		},
		{
			"type": "shell",
			"label": "Build release",
			"command": "cmake --preset release && cmake --build --preset release",
			"options": { "cwd": "${workspaceFolder}" },
			"group": "build",
			"detail": "build-release/ : optimized"
		},
		{
			"type": "shell",
			"label": "Build release (gcc)",
			"command": "cmake --preset release-gcc && cmake --build --preset release-gcc",
			"options": { "cwd": "${workspaceFolder}" },
			"group": "build",
			"detail": "build-release-gcc/ : optimized, gcc"
		},
		{
			"type": "shell",
			"label": "Clean all",
			"command": "rm -rf build build-release build-release-gcc",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": []
		}
	]
}
